DAC8_HIGHPOWER:        equ 03h

DAC8_LSB_CR0:          equ 84h
DAC8_LSB_CR1:          equ 85h
DAC8_LSB_CR2:          equ 86h
DAC8_LSB_CR3:          equ 87h
DAC8_MSB_CR0:          equ 94h
